<?xml version="1.0" encoding="utf-8"?>
<!-- The notification icon is referenced only by name from Dart
     (AndroidInitializationSettings('@drawable/ic_stat_jay')), which the
     release resource shrinker cannot see; without this it may be removed and
     notifications silently fail (flutter_local_notifications README,
     "Release build configuration"). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_jay" />
