{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=calltype;Username=postgres;Password=postgres",
    "BlobStorage": "UseDevelopmentStorage=true"
  },
  "Turn": {
    "Provider": "shared-secret",
    "SharedSecret": "REPLACE_ME_IN_PRODUCTION",
    "TtlSeconds": 86400
  },
  "Jwt": {
    "Secret": "REPLACE_ME_IN_PRODUCTION_MIN_32_CHARS_LONG!!",
    "Issuer": "CallType.Api"
  },
  "Push": {
    "FcmServiceAccountJson": ""
  },
  "BackupLimits": {
    "MaxFileBytes": 8388608,
    "MaxPerAccount": 3,
    "MaxTotalBytes": 268435456
  },
  "Channels": {
    "PostRetentionDays": 90,
    "MaxOwnedPerDevice": 5,
    "MaxImageBytes": 2097152,
    "ReportNotifyEmail": "",
    "PushThrottleMinutes": 10
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:8080"]
  }
}
