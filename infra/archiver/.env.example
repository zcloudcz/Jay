# Copy to infra/archiver/.env (git-ignored) and fill in real values.
# Never commit the real file — it holds BOT_STORE_KEY, the archiver's only
# secret.

# The Jay API this archiver dials out to. No trailing slash.
JAY_API_URL=https://your-jay-api.example.com

# The organization this process archives. One process serves ONE
# organization — see docker-compose.yml for how to add a second one.
JAY_ORG_ID=00000000-0000-0000-0000-000000000000

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this (without a state-volume backup) means a new auditor device —
# see docs/ops/archiver-runbook.md before you provision.
BOT_STORE_KEY=
