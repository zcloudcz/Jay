# CallType beta — pg_hba.conf example (I02)
#
# Purpose: restrict PostgreSQL connections to TLS-only, to the application DB/user only,
# and to known application sources. This is a starting point for the server admin to adapt —
# not a drop-in file (host addresses/CIDRs below are placeholders, see docs/ops/postgres-restore.md
# for how to get the real, current App Service outbound IP list from docs/ops/beta-inventory.md).
#
# Rules:
# - "hostssl" only: plain "host" (unencrypted) and "hostnossl" are forbidden for any non-local rule.
# - No "trust" method anywhere. No 0.0.0.0/0 or ::/0 range.
# - Application account is scoped to its own database, never postgres/superuser.
# - Migration account (separate from the app account, see below) is listed as its own rule so it
#   can be revoked independently without touching the app's runtime access.
# - Keep the default deny-all behavior: any connection not matching a rule above the trailing
#   reject is refused. Do not add a catch-all "hostssl all all ... md5" line.

# TYPE     DATABASE        USER              ADDRESS                    METHOD

# Application runtime account, scoped to the calltype database only.
# Replace <APP_SERVICE_OUTBOUND_CIDR_LIST> with the current outboundIpAddresses from
# `az webapp show --name calltype-beta-zahy ...` (see docs/ops/beta-inventory.md) as /32 entries,
# one per line — do not use possibleOutboundIpAddresses as a permanent allow-list, it is broader
# than what is currently assigned.
hostssl  calltype        calltype_app      <APP_SERVICE_OUTBOUND_CIDR_LIST>/32   scram-sha-256

# Migration account, scoped to the calltype database only, used only from the operator's
# controlled admin host/bastion during a coordinated migration window (see B00 for schema changes).
# Never leave this rule open to the App Service outbound range - migrations run manually or from
# a short-lived, separately audited CI job, not from the running API process.
hostssl  calltype        calltype_migrate  <OPERATOR_ADMIN_SOURCE>/32            scram-sha-256

# Administrative/superuser access: restrict to loopback or a dedicated bastion, never to the
# app's outbound IPs. Keep separate from the two rules above so revoking app/migration access
# never blocks the admin's own path back in.
hostssl  all             postgres          <ADMIN_BASTION_SOURCE>/32             scram-sha-256

# Everything else is implicitly rejected by PostgreSQL when no rule matches - do not add a
# trailing permissive line.

# --- Added 2026-09-29 (O3 backup, O5 VerifyFull, O6 staging) ---------------------------------
# The rules above predate the real beta names. On beta the main database AND its app role are
# both called calltype_prod (docs/ops/postgres-restore.md), the Business-mode database is
# calltype_audit (roles from audit-roles.sql). Scope every line to ONE database + ONE role: with
# staging on the same server (O6) this is what keeps a staging credential out of production,
# because roles are cluster-wide and PUBLIC has CONNECT on every database by default.
hostssl  calltype_prod           calltype_prod               <APP_SERVICE_OUTBOUND_CIDR_LIST>/32  scram-sha-256
hostssl  calltype_audit          calltype_audit_app          <APP_SERVICE_OUTBOUND_CIDR_LIST>/32  scram-sha-256
# Audit schema changes: operator host only (never the App Service range, see HANDOFF-2026-09-18).
hostssl  calltype_audit          calltype_audit_ops          <OPERATOR_ADMIN_SOURCE>/32           scram-sha-256
# backup.sh runs ON the database server: loopback only, read-only role (backup-role.sql).
hostssl  calltype_prod,calltype_audit  calltype_backup       127.0.0.1/32                         scram-sha-256
# Staging (F1 App Service has its OWN outbound IPs: `az webapp show -n calltype-staging-zahy
# --query outboundIpAddresses`). Staging roles only ever reach staging databases.
hostssl  calltype_staging        calltype_staging            <STAGING_OUTBOUND_CIDR_LIST>/32      scram-sha-256
hostssl  calltype_audit_staging  calltype_audit_staging_app  <STAGING_OUTBOUND_CIDR_LIST>/32      scram-sha-256
hostssl  calltype_audit_staging  calltype_audit_staging_ops  <OPERATOR_ADMIN_SOURCE>/32           scram-sha-256
